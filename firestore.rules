rules_version = '2';

// Trust model: anonymous auth + capability URL. Knowing a 20-char session id
// grants participant-level access; the creator (hostUid) gets host powers.
// Sessions can never be listed, so ids stay capability tokens.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /sessions/{sessionId} {

      function session() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }
      function sessionAfter() {
        return getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }
      function isHost() {
        return signedIn() && request.auth.uid == session().hostUid;
      }
      function validExpire(data) {
        // TTL stamped at create, capped to the 7-day policy (+1 day slack).
        return data.expireAt is timestamp
          && data.expireAt < request.time + duration.value(8, 'd');
      }

      allow get: if signedIn();
      allow list: if false;
      allow delete: if false;

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'setup'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0 && request.resource.data.hostName.size() <= 40
        && request.resource.data.currency == 'EUR'
        && request.resource.data.billTotalCents is int && request.resource.data.billTotalCents >= 0
        && request.resource.data.itemCount is int && request.resource.data.itemCount >= 0
        && validExpire(request.resource.data);

      allow update: if signedIn()
        && request.auth.uid == resource.data.hostUid
        // immutable fields
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expireAt == resource.data.expireAt
        // forward-only status machine
        && (
          (resource.data.status == 'setup' && request.resource.data.status in ['setup', 'open'])
          || (resource.data.status == 'open' && request.resource.data.status in ['open', 'closed'])
          || (resource.data.status == 'closed' && request.resource.data.status in ['closed', 'settled'])
        );

      match /items/{itemId} {

        function itemShapeOk(data) {
          return data.name is string && data.name.size() > 0 && data.name.size() <= 80
            && data.unitPriceCents is int && data.unitPriceCents >= 0
            && data.qty is int && data.qty >= 1
            && data.sharedQty is int && data.sharedQty >= 0
            && data.claimedQty is int && data.claimedQty >= 0
            && data.claims is map
            && data.claimedQty + data.sharedQty <= data.qty;
        }

        // Participants update only their own key in `claims`, with an honest
        // counter delta, while the session is open and within the qty bound.
        function participantClaim() {
          let before = resource.data;
          let after = request.resource.data;
          let uid = request.auth.uid;
          return signedIn()
            && session().status == 'open'
            && exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(uid))
            && after.diff(before).affectedKeys().hasOnly(['claims', 'claimedQty'])
            && after.claims.diff(before.claims).affectedKeys().hasOnly([uid])
            && after.claims[uid] is int
            && after.claims[uid] >= 0
            && after.claimedQty == before.claimedQty + after.claims[uid] - before.claims.get(uid, 0)
            && after.claimedQty + after.sharedQty <= after.qty;
        }

        allow read: if signedIn();
        allow create: if isHost()
          && session().status in ['setup', 'open']
          && itemShapeOk(request.resource.data)
          && validExpire(request.resource.data);
        allow delete: if isHost() && session().status in ['setup', 'open'];
        allow update: if (
            isHost()
            && session().status in ['setup', 'open']
            && itemShapeOk(request.resource.data)
            && request.resource.data.expireAt == resource.data.expireAt
          ) || participantClaim();
      }

      match /participants/{pid} {

        function selfJoin() {
          return signedIn()
            && pid == request.auth.uid
            && session().status == 'open'
            && request.resource.data.isManual == false;
        }
        function hostAddsManual() {
          return isHost()
            && session().status in ['setup', 'open']
            && request.resource.data.isManual == true;
        }
        function newParticipantShapeOk(data) {
          return data.displayName is string
            && data.displayName.size() > 0 && data.displayName.size() <= 40
            && data.paid == false
            && data.owedCents == null;
        }

        // Self marks paid after close; host can toggle paid for manual
        // participants (cash on the table) after close.
        function paidToggle() {
          let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
          return session().status == 'closed'
            && diffKeys.hasOnly(['paid', 'paidAt'])
            && request.resource.data.paid is bool
            && (
              (signedIn() && pid == request.auth.uid)
              || (isHost() && resource.data.isManual == true)
            );
        }

        // The close batch: host flips the session to closed and freezes every
        // participant's owedCents in the same batch — getAfter() sees the
        // post-batch session status.
        function closeFreeze() {
          return isHost()
            && sessionAfter().status == 'closed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owedCents'])
            && request.resource.data.owedCents is int
            && request.resource.data.owedCents >= 0;
        }

        allow read: if signedIn();
        allow create: if (selfJoin() || hostAddsManual())
          && newParticipantShapeOk(request.resource.data)
          && validExpire(request.resource.data);
        allow delete: if isHost()
          && session().status in ['setup', 'open']
          && resource.data.isManual == true;
        allow update: if paidToggle() || closeFreeze();
      }
    }
  }
}
